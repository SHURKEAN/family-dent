APP_DOMAIN=dent.example.com
ACME_EMAIL=owner@example.com

POSTGRES_DB=dental_clinic
POSTGRES_USER=dental_app
DB_POOL_MAXIMUM_SIZE=10
DB_POOL_MINIMUM_IDLE=2

BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=replace-admin-name
BOOTSTRAP_ADMIN_FIRST_NAME=Replace
BOOTSTRAP_ADMIN_LAST_NAME=Administrator

SESSION_TIMEOUT=45m
LOGIN_MAXIMUM_FAILURES=5
LOGIN_MAXIMUM_FAILURES_PER_IP=20
LOGIN_WINDOW_MINUTES=15
LOGIN_BLOCK_MINUTES=15
AUDIT_RETENTION_DAYS=365
BOOKING_MAXIMUM_REQUESTS_PER_IP_PER_HOUR=10

BACKUP_HOST_PATH=/srv/family-dent/backups
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=30
SECRETS_DIR=./secrets
